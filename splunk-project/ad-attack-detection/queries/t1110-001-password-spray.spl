index=wineventlog ComputerName="win-dc.soclab.local" EventCode=4624 Logon_Type=3
| eval user=mvindex(Account_Name,-1)
| where user!="ANONYMOUS LOGON" AND user!="-"
| bucket _time span=10m
| stats dc(user) as unique_accounts, values(user) as accounts by _time, Source_Network_Address
| where unique_accounts >= 3
